{
  "name": "mynaui-icons-vue",
  "version": "0.3.1rc",
  "type": "module",
  "description": "MynaUI Icons for Vue.js",
  "keywords": [
    "icons",
    "svg",
    "vue",
    "mynaui",
    "vue-icons",
    "icon-library",
    "icon-pack",
    "icon-set",
    "icons-vue",
    "mynaui-icon"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./*": {
      "types": "./dist/types/components/icons/*.d.ts",
      "import": "./dist/es/components/icons/*.js",
      "require": "./dist/cjs/components/icons/*.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build:icons": "node scripts/generate-components.js",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "build": "npm run clean && npm run build:icons && vite build && npm run build:types",
    "clean": "rm -rf ./dist && find . ! -name '.gitignore' -path './src/components/*' -exec rm -rf {} + "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkfriend/vue-mynaui-icons.git"
  },
  "author": {
    "name": "darkfriend",
    "url": "https://darkfriend.ru"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/darkfriend/vue-mynaui-icons/issues"
  },
  "homepage": "https://github.com/darkfriend/vue-mynaui-icons#readme",
  "dependencies": {
    "@mynaui/icons": "^0.3.9"
  },
  "peerDependencies": {
    "vue": ">=3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "empty-lite": "^2.0.0",
    "fs-extra": "^11.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1"
  }
}
